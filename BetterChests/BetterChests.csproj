<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Name>Better Chests</Name>
    <Description>Framework that adds new features to chests.</Description>
    <Version>2.18.7-unofficial.1</Version>
    <EnableHarmony>true</EnableHarmony>
    <RootNamespace>StardewMods.BetterChests</RootNamespace>
    <UniqueId>furyx639.BetterChests</UniqueId>
    <UpdateKeys>Nexus:9791@SMAPI</UpdateKeys>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModTranslationClassBuilder" Version="2.2.1" />
    <PackageReference Include="SimpleInjector">
      <HintPath>$(GameModsPath)\FauxCore\SimpleInjector.dll</HintPath>
      <Version>5.5.2</Version>
      <Private>false</Private>
    </PackageReference>
    <PackageReference Include="Pidgin">
      <HintPath>$(GameModsPath)\FauxCore\Pidgin.dll</HintPath>
      <Version>3.4.0</Version>
      <Private>false</Private>
    </PackageReference>
    <Reference Include="HarmonyLib">
      <HintPath>$(GamePath)\smapi-internal\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <SMAPIDependency Include="furyx639.FauxCore" Version="1.2.3-unofficial.1" required="true" />
    <SMAPIDependency Include="furyx639.ToolbarIcons" Version="3.2.0" required="false" />
    <SMAPIDependency Include="leclair.bettercrafting" Version="2.18.0" required="false" />
    <SMAPIDependency Include="spacechase0.GenericModConfigMenu" Version="1.16.0" required="false" />
    <SMAPIDependency Include="Pathoschild.Automate" Version="2.6.1" required="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="JetBrains.Annotations" Version="2026.2.0" />
    <PackageReference Update="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
  </ItemGroup>
</Project>
